{
  "openapi": "3.1.0",
  "info": {
    "title": "LADO"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions": {
      "get": {
        "summary": "Sessions",
        "operationId": "sessions_api_sessions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionInfo"
                  },
                  "type": "array",
                  "title": "Response Sessions Api Sessions Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "summary": "Events",
        "description": "The change feed as Server-Sent Events (lado.server.feed). The position is the\nLast-Event-ID header (the browser's own reconnect) or, without it, `after`.",
        "operationId": "events_api_events_get",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After"
            }
          },
          {
            "name": "last-event-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{name}/agents": {
      "get": {
        "summary": "Agents",
        "operationId": "agents_api_sessions__name__agents_get",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgentInfo"
                  },
                  "title": "Response Agents Api Sessions  Name  Agents Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{name}/messages": {
      "get": {
        "summary": "Messages",
        "description": "The session's messages from and to `with`, the human: the chat, oldest first.",
        "operationId": "messages_api_sessions__name__messages_get",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          },
          {
            "name": "with",
            "in": "query",
            "required": true,
            "schema": {
              "const": "human",
              "type": "string",
              "title": "With"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MessageInfo"
                  },
                  "title": "Response Messages Api Sessions  Name  Messages Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Write",
        "description": "The human's text to an agent of the session (default: the supervisor), through\nthe same queue and delivery as an agent's message.",
        "operationId": "write_api_sessions__name__messages_post",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageText"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sent"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{name}/questions/{question}/answer": {
      "post": {
        "summary": "Answer",
        "description": "The human's answer to an agent's open question: a choice, own words, or both.",
        "operationId": "answer_api_sessions__name__questions__question__answer_post",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          },
          {
            "name": "question",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Question"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Answer"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sent"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{name}/questions/{question}/dismiss": {
      "post": {
        "summary": "Dismiss",
        "description": "The human dismisses an agent's open question; the agent hears of it.",
        "operationId": "dismiss_api_sessions__name__questions__question__dismiss_post",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          },
          {
            "name": "question",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Question"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sent"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{name}/agents/{agent}/history": {
      "get": {
        "summary": "History",
        "description": "The agent's window: its last `lines` lines, for the UI's read-only history, and\nwhether the agent shows a full-screen program, whose history is inside it.",
        "operationId": "history_api_sessions__name__agents__agent__history_get",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          },
          {
            "name": "agent",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Agent"
            }
          },
          {
            "name": "lines",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50000,
              "minimum": 1,
              "default": 2000,
              "title": "Lines"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/History"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "status": {
            "type": "string",
            "enum": [
              "starting",
              "busy",
              "idle",
              "waiting",
              "stopped"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "name",
          "role",
          "provider",
          "status"
        ],
        "title": "AgentInfo"
      },
      "Answer": {
        "properties": {
          "choice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Choice"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "type": "object",
        "title": "Answer"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "version"
        ],
        "title": "Health"
      },
      "History": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "alternate": {
            "type": "boolean",
            "title": "Alternate"
          }
        },
        "type": "object",
        "required": [
          "text",
          "alternate"
        ],
        "title": "History"
      },
      "MessageInfo": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "from": {
            "type": "string",
            "title": "From"
          },
          "to": {
            "type": "string",
            "title": "To"
          },
          "kind": {
            "type": "string",
            "enum": [
              "message",
              "question"
            ],
            "title": "Kind"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "sent",
              "delivered",
              "read",
              "dropped",
              "failed"
            ],
            "title": "State"
          },
          "choices": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Choices"
          },
          "free_answer": {
            "type": "boolean",
            "title": "Free Answer"
          },
          "question_state": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "open",
                  "answered",
                  "dismissed",
                  "closed"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Question State"
          },
          "answered_by": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answered By"
          },
          "reply_to": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reply To"
          },
          "choice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Choice"
          },
          "reply_state": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "replied",
                  "missing"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reply State"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "kind",
          "summary",
          "body",
          "state",
          "choices",
          "free_answer",
          "question_state",
          "answered_by",
          "reply_to",
          "choice",
          "reply_state",
          "created_at"
        ],
        "title": "MessageInfo",
        "description": "A message, a question to the human (kind \"question\") or an answer to one."
      },
      "MessageText": {
        "properties": {
          "to": {
            "type": "string",
            "title": "To",
            "default": "supervisor"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "MessageText",
        "description": "The human's text from the composer."
      },
      "Sent": {
        "properties": {
          "result": {
            "type": "string",
            "title": "Result"
          }
        },
        "type": "object",
        "required": [
          "result"
        ],
        "title": "Sent"
      },
      "SessionInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "repo": {
            "type": "string",
            "title": "Repo"
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          },
          "agents": {
            "type": "integer",
            "title": "Agents"
          }
        },
        "type": "object",
        "required": [
          "name",
          "repo",
          "status",
          "agents"
        ],
        "title": "SessionInfo"
      },
      "SessionStatus": {
        "type": "string",
        "enum": [
          "stopped",
          "running",
          "tmux_gone",
          "loop_down"
        ],
        "title": "SessionStatus",
        "description": "Whether a session runs, as `lado ls` and the UI show it."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
