{
  "openapi": "3.1.0",
  "info": {
    "title": "LADO",
    "version": "0.11.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions": {
      "get": {
        "summary": "Sessions",
        "operationId": "sessions_api_sessions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionInfo"
                  },
                  "type": "array",
                  "title": "Response Sessions Api Sessions Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "version"
        ],
        "title": "Health"
      },
      "SessionInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "repo": {
            "type": "string",
            "title": "Repo"
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          },
          "agents": {
            "type": "integer",
            "title": "Agents"
          }
        },
        "type": "object",
        "required": [
          "name",
          "repo",
          "status",
          "agents"
        ],
        "title": "SessionInfo"
      },
      "SessionStatus": {
        "type": "string",
        "enum": [
          "stopped",
          "running",
          "tmux_gone",
          "loop_down"
        ],
        "title": "SessionStatus",
        "description": "Whether a session runs, as `lado ls` and the UI show it."
      }
    }
  }
}
